{
  "expo": {
    "name": "Quran Masterclass",
    "slug": "quran-masterclass",
    "scheme": "quranmasterclass",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon-gold.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.quranmasterclass.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:quranmasterclass.com",
        "applinks:www.quranmasterclass.com",
        "webcredentials:quranmasterclass.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "de",
          "ar",
          "tr",
          "ur",
          "fa",
          "ps",
          "fr",
          "es",
          "id",
          "ms",
          "bn",
          "ru",
          "zh-Hans"
        ],
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories",
          "facebook-stories",
          "fb",
          "fbapi",
          "fb-messenger",
          "snssdk1233",
          "tiktok",
          "whatsapp",
          "tg",
          "sgnl",
          "viber",
          "sms",
          "mailto",
          "snapchat",
          "line",
          "weixin",
          "twitter",
          "barcelona"
        ]
      },
      "buildNumber": "21",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePurchaseHistory",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality",
              "NSPrivacyCollectedDataTypePurposeAnalytics"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherDataTypes",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.quranmasterclass.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground-gold.png",
        "backgroundImage": "./assets/android-icon-background-gold.png",
        "monochromeImage": "./assets/android-icon-monochrome-gold.png",
        "backgroundColor": "#08261D"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 4,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon-gold.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": "Quran Masterclass uses the microphone only when you start a recording, the recitation check or the word check. A recording stays on this device unless you choose to send or publish it."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-localization",
      "expo-iap",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-gold.png",
          "imageWidth": 160,
          "backgroundColor": "#08261D",
          "dark": {
            "backgroundColor": "#071611"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quran Masterclass uses your location only on this device to calculate prayer times and the Qibla direction for where you are. It is not stored or sent anywhere.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#066C4E"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Quran Masterclass opens your photos only when you choose a profile picture. Only the picture you pick is uploaded, without its location data.",
          "savePhotosPermission": "Quran Masterclass saves the verse images and videos you choose to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Quran Masterclass uses the microphone only when you start a recording, the recitation check or the word check. A recording stays on this device unless you choose to send or publish it.",
          "speechRecognitionPermission": "Quran Masterclass recognises the Arabic words you recite on this device, in exercises, tests and the word check, to show which words were heard. It is not a tajweed assessment and nothing is uploaded."
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Quran Masterclass uses the camera only when you take a profile picture or, where offered, switch on video for a recitation clip. Nothing is recorded until you start.",
          "microphonePermission": "Quran Masterclass uses the microphone only when you start a recording, the recitation check or the word check. A recording stays on this device unless you choose to send or publish it.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Quran Masterclass opens your photos only when you choose a profile picture. Only the picture you pick is uploaded, without its location data.",
          "cameraPermission": "Quran Masterclass uses the camera only when you take a profile picture or, where offered, switch on video for a recitation clip. Nothing is recorded until you start.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "icslfze",
    "locales": {
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "ar": "./locales/ar.json",
      "tr": "./locales/tr.json",
      "ur": "./locales/ur.json",
      "fa": "./locales/fa.json",
      "ps": "./locales/ps.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "id": "./locales/id.json",
      "ms": "./locales/ms.json",
      "bn": "./locales/bn.json",
      "ru": "./locales/ru.json",
      "zh-Hans": "./locales/zh.json"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ead86b27-d37e-4815-acc1-d9e6fd85d9c8"
      }
    }
  }
}
