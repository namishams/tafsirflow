{
  "expo": {
    "name": "Quran Masterclass",
    "slug": "quran-masterclass",
    "scheme": "quranmasterclass",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.quranmasterclass.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:quranmasterclass.com",
        "applinks:www.quranmasterclass.com",
        "webcredentials:quranmasterclass.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "de",
          "ar",
          "tr",
          "ur",
          "fa",
          "ps",
          "fr",
          "es",
          "id",
          "ms",
          "bn",
          "ru",
          "zh-Hans"
        ]
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.quranmasterclass.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#08261D"
      },
      "predictiveBackGestureEnabled": true,
      "versionCode": 4,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": "Quran Masterclass uses the microphone only when you start the recitation check. Your recording stays on this device and is not uploaded."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-iap",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F5F7F6",
          "dark": {
            "backgroundColor": "#071611"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quran Masterclass uses your location only on this device to calculate prayer times and the Qibla direction for where you are. It is not stored or sent anywhere."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#066C4E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "icslfze",
    "locales": {
      "en": "./locales/en.json",
      "de": "./locales/de.json",
      "ar": "./locales/ar.json",
      "tr": "./locales/tr.json",
      "ur": "./locales/ur.json",
      "fa": "./locales/fa.json",
      "ps": "./locales/ps.json",
      "fr": "./locales/fr.json",
      "es": "./locales/es.json",
      "id": "./locales/id.json",
      "ms": "./locales/ms.json",
      "bn": "./locales/bn.json",
      "ru": "./locales/ru.json",
      "zh-Hans": "./locales/zh.json"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ead86b27-d37e-4815-acc1-d9e6fd85d9c8"
      }
    }
  }
}
