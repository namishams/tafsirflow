{
  "expo": {
    "name": "Quran Masterclass",
    "slug": "quran-masterclass",
    "scheme": "quranmasterclass",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.quranmasterclass.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:quranmasterclass.com",
        "applinks:www.quranmasterclass.com",
        "webcredentials:quranmasterclass.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.quranmasterclass.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#08261D"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-iap",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quran Masterclass uses your location only to calculate prayer times and the Qibla direction for where you are. It is not stored or shared."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
